# Local secrets and environment
.env
.env.local
.env.*.local
app/config/local.php

# Local import data (CSV exports — do not commit)
data/
*.csv

# Logs and cache
*.log
cache/
tmp/

# Archives — do not commit project snapshots bundled as archives
*.zip
*.7z
*.tar
*.tar.gz

# Database dumps and export trees (sql/ may keep reference snippets — avoid blanket *.sql)
dumps/
backups/
exports/
*.dump.sql
*.backup.sql
*.sql.gz
*_database_*.sql
*_prod.sql

# Composer (if added)
/vendor/

# PHP / test tooling caches
.phpunit.result.cache
.php-cs-fixer.cache

# IDE / OS clutter
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini
*.swp
*~

# Local scratch / notes (optional)
scratch/
